rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isActiveUser() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active';
    }

    function hasVerifiedEmail() {
      return signedIn() &&
        (request.auth.token.firebase.sign_in_provider != 'password' ||
         request.auth.token.email_verified == true);
    }

    function isAdmin() {
      return hasVerifiedEmail() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active';
    }

    function hasExactFields(requiredFields) {
      return request.resource.data.keys().hasAll(requiredFields) &&
        request.resource.data.keys().hasOnly(requiredFields);
    }

    function validAdminRoleUpdate(userId) {
      return isAdmin() &&
        request.auth.uid != userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role', 'updatedAt']) &&
        request.resource.data.role in ['user', 'admin'] &&
        request.resource.data.updatedAt == request.time;
    }

    function validPakistaniPaymentMethod(data) {
      return data.method in ['JazzCash', 'Easypaisa', 'SadaPay', 'NayaPay', 'Pakistani Bank Account'] &&
        ((data.method in ['JazzCash', 'Easypaisa'] && data.paymentCategory == 'Mobile wallet') ||
         (data.method in ['SadaPay', 'NayaPay'] && data.paymentCategory == 'Digital bank') ||
         (data.method == 'Pakistani Bank Account' && data.paymentCategory == 'Bank transfer')) &&
        ((data.method == 'Pakistani Bank Account' && data.keys().hasAll(['bankName']) && data.bankName is string && data.bankName.size() > 0) ||
         (data.method != 'Pakistani Bank Account' && !data.keys().hasAny(['bankName'])));
    }

    function validFundingNotification() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'type', 'title', 'message', 'read', 'createdAt', 'referenceType', 'referenceId']) &&
        data.keys().hasOnly(['userId', 'type', 'title', 'message', 'read', 'createdAt', 'referenceType', 'referenceId']) &&
        data.type in ['deposit_approved', 'deposit_rejected', 'withdrawal_approved', 'withdrawal_rejected'] &&
        data.referenceType in ['deposit', 'withdrawal'] &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 80 &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 240 &&
        data.read == false && data.createdAt == request.time &&
        ((data.referenceType == 'deposit' &&
          getAfter(/databases/$(database)/documents/deposits/$(data.referenceId)).data.userId == data.userId &&
          ((data.type == 'deposit_approved' && getAfter(/databases/$(database)/documents/deposits/$(data.referenceId)).data.status == 'approved') ||
           (data.type == 'deposit_rejected' && getAfter(/databases/$(database)/documents/deposits/$(data.referenceId)).data.status == 'rejected'))) ||
         (data.referenceType == 'withdrawal' &&
          getAfter(/databases/$(database)/documents/withdrawals/$(data.referenceId)).data.userId == data.userId &&
          ((data.type == 'withdrawal_approved' && getAfter(/databases/$(database)/documents/withdrawals/$(data.referenceId)).data.status == 'approved') ||
           (data.type == 'withdrawal_rejected' && getAfter(/databases/$(database)/documents/withdrawals/$(data.referenceId)).data.status == 'rejected'))));
    }

    function validCompletedTransaction(transactionId) {
      let transactionData = request.resource.data;
      let walletBefore = get(
        /databases/$(database)/documents/wallets/$(transactionData.userId)
      ).data;
      let walletAfter = getAfter(
        /databases/$(database)/documents/wallets/$(transactionData.userId)
      ).data;
      return hasExactFields([
          'userId',
          'type',
          'amount',
          'currency',
          'status',
          'referenceId',
          'createdAt'
        ]) &&
        transactionData.userId is string &&
        transactionData.amount is number &&
        transactionData.amount > 0 &&
        transactionData.currency == 'USD' &&
        transactionData.status == 'completed' &&
        transactionData.type in ['deposit', 'withdrawal'] &&
        transactionData.createdAt == request.time &&
        walletAfter.lastTransactionId == transactionId &&
        (
          (
            transactionData.type == 'deposit' &&
            get(
              /databases/$(database)/documents/deposits/$(transactionData.referenceId)
            ).data.status == 'pending' &&
            getAfter(
              /databases/$(database)/documents/deposits/$(transactionData.referenceId)
            ).data.status == 'approved' &&
            getAfter(
              /databases/$(database)/documents/deposits/$(transactionData.referenceId)
            ).data.userId == transactionData.userId &&
            getAfter(
              /databases/$(database)/documents/deposits/$(transactionData.referenceId)
            ).data.amount == transactionData.amount &&
            walletAfter.availableBalance ==
              walletBefore.availableBalance + transactionData.amount &&
            walletAfter.totalDeposited ==
              walletBefore.totalDeposited + transactionData.amount &&
            walletAfter.totalWithdrawn == walletBefore.totalWithdrawn
          ) ||
          (
            transactionData.type == 'withdrawal' &&
            get(
              /databases/$(database)/documents/withdrawals/$(transactionData.referenceId)
            ).data.status == 'pending' &&
            getAfter(
              /databases/$(database)/documents/withdrawals/$(transactionData.referenceId)
            ).data.status == 'approved' &&
            getAfter(
              /databases/$(database)/documents/withdrawals/$(transactionData.referenceId)
            ).data.userId == transactionData.userId &&
            getAfter(
              /databases/$(database)/documents/withdrawals/$(transactionData.referenceId)
            ).data.amount == transactionData.amount &&
            walletBefore.availableBalance >= transactionData.amount &&
            walletAfter.availableBalance ==
              walletBefore.availableBalance - transactionData.amount &&
            walletAfter.totalWithdrawn ==
              walletBefore.totalWithdrawn + transactionData.amount &&
            walletAfter.totalDeposited == walletBefore.totalDeposited
          )
        );
    }

    function validWalletApprovalUpdate(userId) {
      let transactionId = request.resource.data.lastTransactionId;
      let transactionAfter = getAfter(
        /databases/$(database)/documents/transactions/$(transactionId)
      ).data;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'availableBalance',
          'totalDeposited',
          'totalWithdrawn',
          'updatedAt',
          'lastTransactionId'
        ]) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.currency == resource.data.currency &&
        request.resource.data.lockedBalance == resource.data.lockedBalance &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.availableBalance is number &&
        request.resource.data.availableBalance >= 0 &&
        request.resource.data.totalDeposited is number &&
        request.resource.data.totalWithdrawn is number &&
        request.resource.data.updatedAt == request.time &&
        transactionAfter.userId == userId &&
        transactionAfter.amount > 0 &&
        (
          (
            transactionAfter.type == 'deposit' &&
            get(
              /databases/$(database)/documents/deposits/$(transactionAfter.referenceId)
            ).data.status == 'pending' &&
            getAfter(
              /databases/$(database)/documents/deposits/$(transactionAfter.referenceId)
            ).data.status == 'approved' &&
            request.resource.data.availableBalance ==
              resource.data.availableBalance + transactionAfter.amount &&
            request.resource.data.totalDeposited ==
              resource.data.totalDeposited + transactionAfter.amount &&
            request.resource.data.totalWithdrawn == resource.data.totalWithdrawn
          ) ||
          (
            transactionAfter.type == 'withdrawal' &&
            get(
              /databases/$(database)/documents/withdrawals/$(transactionAfter.referenceId)
            ).data.status == 'pending' &&
            getAfter(
              /databases/$(database)/documents/withdrawals/$(transactionAfter.referenceId)
            ).data.status == 'approved' &&
            resource.data.availableBalance >= transactionAfter.amount &&
            request.resource.data.availableBalance ==
              resource.data.availableBalance - transactionAfter.amount &&
            request.resource.data.totalWithdrawn ==
              resource.data.totalWithdrawn + transactionAfter.amount &&
            request.resource.data.totalDeposited == resource.data.totalDeposited
          )
        );
    }

    function validDepositApproval(depositId) {
      let walletAfter = getAfter(
        /databases/$(database)/documents/wallets/$(resource.data.userId)
      ).data;
      let transactionAfter = getAfter(
        /databases/$(database)/documents/transactions/$(walletAfter.lastTransactionId)
      ).data;
      return resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'approvedBy',
          'approvedAt',
          'updatedAt'
        ]) &&
        request.resource.data.status == 'approved' &&
        request.resource.data.approvedBy == request.auth.uid &&
        request.resource.data.approvedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        transactionAfter.type == 'deposit' &&
        transactionAfter.referenceId == depositId &&
        transactionAfter.userId == resource.data.userId &&
        transactionAfter.amount == resource.data.amount &&
        transactionAfter.currency == resource.data.currency &&
        transactionAfter.status == 'completed';
    }

    function validDepositRejection() {
      return resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'rejectionReason',
          'rejectedBy',
          'rejectedAt',
          'updatedAt'
        ]) &&
        request.resource.data.status == 'rejected' &&
        request.resource.data.rejectionReason is string &&
        request.resource.data.rejectionReason.size() > 0 &&
        request.resource.data.rejectedBy == request.auth.uid &&
        request.resource.data.rejectedAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function validWithdrawalApproval(withdrawalId) {
      let walletBefore = get(
        /databases/$(database)/documents/wallets/$(resource.data.userId)
      ).data;
      let walletAfter = getAfter(
        /databases/$(database)/documents/wallets/$(resource.data.userId)
      ).data;
      let transactionAfter = getAfter(
        /databases/$(database)/documents/transactions/$(walletAfter.lastTransactionId)
      ).data;
      return resource.data.status == 'pending' &&
        walletBefore.availableBalance >= resource.data.amount &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'approvedBy',
          'approvedAt',
          'updatedAt'
        ]) &&
        request.resource.data.status == 'approved' &&
        request.resource.data.approvedBy == request.auth.uid &&
        request.resource.data.approvedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        transactionAfter.type == 'withdrawal' &&
        transactionAfter.referenceId == withdrawalId &&
        transactionAfter.userId == resource.data.userId &&
        transactionAfter.amount == resource.data.amount &&
        transactionAfter.currency == resource.data.currency &&
        transactionAfter.status == 'completed';
    }

    function validWithdrawalRejection() {
      return resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'rejectionReason',
          'rejectedBy',
          'rejectedAt',
          'updatedAt'
        ]) &&
        request.resource.data.status == 'rejected' &&
        request.resource.data.rejectionReason is string &&
        request.resource.data.rejectionReason.size() > 0 &&
        request.resource.data.rejectedBy == request.auth.uid &&
        request.resource.data.rejectedAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function closeEnough(actual, expected) {
      return actual >= expected - 0.000001 && actual <= expected + 0.000001;
    }

    function validTradingSymbol(symbol) {
      return symbol in [
        'BTCUSDT', 'ETHUSDT', 'BNBUSDT', 'SOLUSDT', 'XRPUSDT',
        'ADAUSDT', 'DOGEUSDT', 'AVAXUSDT', 'LINKUSDT', 'LTCUSDT',
        'EURUSD', 'GBPUSD', 'USDJPY', 'USDCHF', 'AUDUSD', 'USDCAD',
        'NZDUSD', 'EURJPY', 'GBPJPY', 'EURGBP', 'XAUUSD'
      ];
    }

    function validTpTarget(target, entryPrice) {
      return target.keys().hasAll(['id', 'price', 'closePercent', 'status']) &&
        target.keys().hasOnly(['id', 'price', 'closePercent', 'status']) &&
        target.id is string && target.id.size() > 0 &&
        target.price is number && target.price > entryPrice &&
        target.closePercent is number && target.closePercent > 0 && target.closePercent <= 100 &&
        target.status in ['pending', 'triggered', 'cancelled'];
    }

    function validTargets(data) {
      return !data.keys().hasAny(['takeProfitTargets']) ||
        (data.takeProfitTargets is list && data.takeProfitTargets.size() <= 3 &&
         (data.takeProfitTargets.size() < 1 || validTpTarget(data.takeProfitTargets[0], data.averageEntryPrice)) &&
         (data.takeProfitTargets.size() < 2 || (validTpTarget(data.takeProfitTargets[1], data.averageEntryPrice) && data.takeProfitTargets[1].price > data.takeProfitTargets[0].price)) &&
         (data.takeProfitTargets.size() < 3 || (validTpTarget(data.takeProfitTargets[2], data.averageEntryPrice) && data.takeProfitTargets[2].price > data.takeProfitTargets[1].price)) &&
         (data.takeProfitTargets.size() < 1 || data.takeProfitTargets[0].closePercent +
           (data.takeProfitTargets.size() > 1 ? data.takeProfitTargets[1].closePercent : 0) +
           (data.takeProfitTargets.size() > 2 ? data.takeProfitTargets[2].closePercent : 0) <= 100) &&
         (data.takeProfitTargets.size() == 0 ||
           (data.takeProfitBaseQuantity is number && data.takeProfitBaseQuantity > 0)));
    }

    function validProtection(data) {
      return (!data.keys().hasAny(['stopLoss']) || data.stopLoss == null ||
          (data.stopLoss is number && data.stopLoss > 0 && data.stopLoss <= data.averageEntryPrice * 1.003)) &&
        (!data.keys().hasAny(['takeProfit']) || data.takeProfit == null ||
          (data.takeProfit is number && data.takeProfit > data.averageEntryPrice)) &&
        validTargets(data) &&
        (!data.keys().hasAny(['trailingStopEnabled']) ||
          (data.trailingStopEnabled == false) ||
          (data.trailingStopEnabled == true &&
           data.trailingStopPercent is number && data.trailingStopPercent >= 0.1 && data.trailingStopPercent <= 25 &&
           data.trailingHighWaterMark is number && data.trailingHighWaterMark >= data.averageEntryPrice &&
           data.trailingStopPrice is number && data.trailingStopPrice > 0 &&
           closeEnough(data.trailingStopPrice, data.trailingHighWaterMark * (1 - data.trailingStopPercent / 100))));
    }

    function validTradeShape(tradeId, tradeData) {
      let positionId = tradeData.userId + '_' + tradeData.symbol;
      let positionBefore = get(
        /databases/$(database)/documents/positions/$(positionId)
      ).data;
      return tradeData.keys().hasAll([
          'userId', 'symbol', 'marketType', 'side', 'quantity',
          'executionPrice', 'grossAmount', 'fee', 'netAmount',
          'realizedPnl', 'status', 'createdAt'
        ]) &&
        tradeData.keys().hasOnly([
          'userId', 'symbol', 'marketType', 'side', 'quantity',
          'executionPrice', 'grossAmount', 'fee', 'netAmount',
          'realizedPnl', 'status', 'createdAt', 'orderId', 'closeReason', 'automationId'
        ]) &&
        tradeData.userId == request.auth.uid &&
        tradeData.symbol is string &&
        tradeData.marketType in ['crypto', 'forex'] &&
        tradeData.side in ['BUY', 'SELL'] &&
        tradeData.quantity is number && tradeData.quantity > 0 &&
        tradeData.executionPrice is number && tradeData.executionPrice > 0 &&
        tradeData.grossAmount is number && tradeData.grossAmount >= 1 &&
        closeEnough(tradeData.grossAmount, tradeData.quantity * tradeData.executionPrice) &&
        tradeData.fee is number && tradeData.fee >= 0 &&
        closeEnough(tradeData.fee, tradeData.grossAmount * 0.001) &&
        tradeData.netAmount is number && tradeData.netAmount > 0 &&
        closeEnough(
          tradeData.netAmount,
          tradeData.side == 'BUY'
            ? tradeData.grossAmount + tradeData.fee
            : tradeData.grossAmount - tradeData.fee
        ) &&
        tradeData.realizedPnl is number &&
        (
          (tradeData.side == 'BUY' && tradeData.realizedPnl == 0) ||
          (tradeData.side == 'SELL' &&
            positionBefore.userId == tradeData.userId &&
            positionBefore.symbol == tradeData.symbol &&
            positionBefore.marketType == tradeData.marketType &&
            positionBefore.status == 'open' &&
            tradeData.quantity <= positionBefore.quantity &&
            closeEnough(
              tradeData.realizedPnl,
              (tradeData.executionPrice - positionBefore.averageEntryPrice) *
                tradeData.quantity - tradeData.fee
            ))
        ) &&
        tradeData.status == 'filled' &&
        tradeData.createdAt == request.time &&
        (!tradeData.keys().hasAny(['closeReason']) ||
          (tradeData.side == 'SELL' && tradeData.closeReason in ['stopLoss', 'trailingStop', 'takeProfit'])) &&
        (!tradeData.keys().hasAny(['automationId']) ||
          (tradeData.closeReason == 'takeProfit' && tradeData.automationId is string)) &&
        (!tradeData.keys().hasAny(['orderId']) ||
          (getAfter(/databases/$(database)/documents/orders/$(tradeData.orderId)).data.status == 'filled' &&
           getAfter(/databases/$(database)/documents/orders/$(tradeData.orderId)).data.fillTradeId == tradeId)) &&
        getAfter(/databases/$(database)/documents/wallets/$(tradeData.userId)).data.lastTradeId == tradeId &&
        getAfter(/databases/$(database)/documents/positions/$(positionId)).data.lastTradeId == tradeId;
    }

    function validWalletTradeUpdate(userId) {
      let tradeId = request.resource.data.lastTradeId;
      let tradePath = /databases/$(database)/documents/trades/$(tradeId);
      let tradeAfter = getAfter(tradePath).data;
      return !exists(tradePath) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'availableBalance', 'updatedAt', 'lastTradeId'
        ]) &&
        request.resource.data.availableBalance is number &&
        request.resource.data.availableBalance >= 0 &&
        request.resource.data.updatedAt == request.time &&
        tradeAfter.userId == userId &&
        tradeAfter.status == 'filled' &&
        (
          (tradeAfter.side == 'BUY' &&
            closeEnough(request.resource.data.availableBalance, resource.data.availableBalance - tradeAfter.netAmount)) ||
          (tradeAfter.side == 'SELL' &&
            closeEnough(request.resource.data.availableBalance, resource.data.availableBalance + tradeAfter.netAmount))
        );
    }

    function validPositionCreate(positionId) {
      let tradeId = request.resource.data.lastTradeId;
      let tradePath = /databases/$(database)/documents/trades/$(tradeId);
      let tradeAfter = getAfter(tradePath).data;
      return !exists(tradePath) &&
        hasExactFields([
          'userId', 'symbol', 'marketType', 'quantity', 'averageEntryPrice',
          'investedAmount', 'realizedPnl', 'status', 'createdAt',
          'updatedAt', 'lastTradeId', 'openedAt', 'stopLoss', 'takeProfit',
          'takeProfitTargets', 'takeProfitBaseQuantity', 'trailingStopEnabled',
          'trailingStopPercent', 'trailingHighWaterMark', 'trailingStopPrice'
        ]) &&
        positionId == request.auth.uid + '_' + request.resource.data.symbol &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.marketType in ['crypto', 'forex'] &&
        request.resource.data.quantity > 0 &&
        request.resource.data.realizedPnl == 0 &&
        request.resource.data.status == 'open' &&
        request.resource.data.openedAt == request.time &&
        validProtection(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        tradeAfter.side == 'BUY' &&
        tradeAfter.userId == request.resource.data.userId &&
        tradeAfter.symbol == request.resource.data.symbol &&
        tradeAfter.marketType == request.resource.data.marketType &&
        closeEnough(request.resource.data.quantity, tradeAfter.quantity) &&
        closeEnough(request.resource.data.averageEntryPrice, tradeAfter.executionPrice) &&
        closeEnough(request.resource.data.investedAmount, tradeAfter.grossAmount);
    }

    function validPositionUpdate() {
      let tradeId = request.resource.data.lastTradeId;
      let tradePath = /databases/$(database)/documents/trades/$(tradeId);
      let tradeAfter = getAfter(tradePath).data;
      return !exists(tradePath) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quantity', 'averageEntryPrice', 'investedAmount', 'realizedPnl',
          'status', 'updatedAt', 'lastTradeId', 'openedAt', 'stopLoss', 'takeProfit',
          'takeProfitTargets', 'takeProfitBaseQuantity', 'trailingStopEnabled',
          'trailingStopPercent', 'trailingHighWaterMark', 'trailingStopPrice'
        ]) &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.quantity >= 0 &&
        request.resource.data.investedAmount >= 0 &&
        validProtection(request.resource.data) &&
        tradeAfter.userId == resource.data.userId &&
        tradeAfter.symbol == resource.data.symbol &&
        tradeAfter.marketType == resource.data.marketType &&
        (
          (tradeAfter.side == 'BUY' &&
            request.resource.data.status == 'open' &&
            closeEnough(request.resource.data.quantity, resource.data.quantity + tradeAfter.quantity) &&
            closeEnough(request.resource.data.investedAmount, resource.data.investedAmount + tradeAfter.grossAmount) &&
            closeEnough(
              request.resource.data.averageEntryPrice,
              ((resource.data.quantity * resource.data.averageEntryPrice) +
                (tradeAfter.quantity * tradeAfter.executionPrice)) /
                (resource.data.quantity + tradeAfter.quantity)
            ) &&
            request.resource.data.realizedPnl == resource.data.realizedPnl) ||
          (tradeAfter.side == 'SELL' &&
            resource.data.status == 'open' &&
            tradeAfter.quantity <= resource.data.quantity &&
            closeEnough(request.resource.data.quantity, resource.data.quantity - tradeAfter.quantity) &&
            closeEnough(request.resource.data.realizedPnl, resource.data.realizedPnl + tradeAfter.realizedPnl) &&
            closeEnough(request.resource.data.investedAmount, request.resource.data.averageEntryPrice * request.resource.data.quantity) &&
            (
              (request.resource.data.quantity == 0 && request.resource.data.status == 'closed' && request.resource.data.averageEntryPrice == 0) ||
              (request.resource.data.quantity > 0 && request.resource.data.status == 'open' && request.resource.data.averageEntryPrice == resource.data.averageEntryPrice)
            ))
        );
    }

    function validProtectionUpdate() {
      return resource.data.status == 'open' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'stopLoss', 'takeProfit', 'takeProfitTargets', 'takeProfitBaseQuantity',
            'trailingStopEnabled', 'trailingStopPercent', 'trailingHighWaterMark',
            'trailingStopPrice', 'updatedAt'
          ]) &&
        request.resource.data.updatedAt == request.time &&
        validProtection(request.resource.data);
    }

    function validPendingOrderCreate() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'userId', 'symbol', 'marketType', 'side', 'orderType', 'quantity',
          'limitPrice', 'stopLoss', 'takeProfit', 'reduceOnly', 'status', 'createdAt',
          'updatedAt', 'filledAt', 'filledPrice', 'fillTradeId', 'cancelledAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'symbol', 'marketType', 'side', 'orderType', 'quantity',
          'limitPrice', 'stopLoss', 'takeProfit', 'reduceOnly', 'status', 'createdAt',
          'updatedAt', 'filledAt', 'filledPrice', 'fillTradeId', 'cancelledAt'
        ]) &&
        data.userId == request.auth.uid && validTradingSymbol(data.symbol) &&
        data.marketType in ['crypto', 'forex'] && data.side in ['BUY', 'SELL'] &&
        data.orderType == 'limit' && data.quantity is number && data.quantity > 0 &&
        data.limitPrice is number && data.limitPrice > 0 &&
        ((data.side == 'BUY' && data.reduceOnly == false &&
          (data.stopLoss == null || (data.stopLoss is number && data.stopLoss > 0 && data.stopLoss < data.limitPrice)) &&
          (data.takeProfit == null || (data.takeProfit is number && data.takeProfit > data.limitPrice))) ||
         (data.side == 'SELL' && data.reduceOnly == true && data.stopLoss == null && data.takeProfit == null &&
          get(/databases/$(database)/documents/positions/$(request.auth.uid + '_' + data.symbol)).data.status == 'open' &&
          data.quantity <= get(/databases/$(database)/documents/positions/$(request.auth.uid + '_' + data.symbol)).data.quantity)) &&
        data.status == 'pending' && data.createdAt == request.time &&
        data.updatedAt == request.time && data.filledAt == null &&
        data.filledPrice == null && data.fillTradeId == null && data.cancelledAt == null;
    }

    function validOrderCancel() {
      return resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'cancelledAt', 'updatedAt']) &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.cancelledAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function validOrderEdit() {
      return resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['quantity', 'limitPrice', 'stopLoss', 'takeProfit', 'updatedAt']) &&
        request.resource.data.quantity is number && request.resource.data.quantity > 0 &&
        request.resource.data.limitPrice is number && request.resource.data.limitPrice > 0 &&
        ((resource.data.side == 'BUY' &&
          (request.resource.data.stopLoss == null || (request.resource.data.stopLoss is number && request.resource.data.stopLoss > 0 && request.resource.data.stopLoss < request.resource.data.limitPrice)) &&
          (request.resource.data.takeProfit == null || (request.resource.data.takeProfit is number && request.resource.data.takeProfit > request.resource.data.limitPrice))) ||
         (resource.data.side == 'SELL' && resource.data.reduceOnly == true &&
          request.resource.data.stopLoss == null && request.resource.data.takeProfit == null &&
          get(/databases/$(database)/documents/positions/$(request.auth.uid + '_' + resource.data.symbol)).data.status == 'open' &&
          request.resource.data.quantity <= get(/databases/$(database)/documents/positions/$(request.auth.uid + '_' + resource.data.symbol)).data.quantity)) &&
        request.resource.data.updatedAt == request.time;
    }

    function validOrderFill(orderId) {
      let tradeId = request.resource.data.fillTradeId;
      let tradeAfter = getAfter(/databases/$(database)/documents/trades/$(tradeId)).data;
      return resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'filledAt', 'filledPrice', 'fillTradeId', 'updatedAt']) &&
        request.resource.data.status == 'filled' &&
        request.resource.data.filledAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.filledPrice is number && request.resource.data.filledPrice > 0 &&
        ((resource.data.side == 'BUY' && request.resource.data.filledPrice <= resource.data.limitPrice) ||
         (resource.data.side == 'SELL' && resource.data.reduceOnly == true && request.resource.data.filledPrice >= resource.data.limitPrice)) &&
        tradeAfter.orderId == orderId && tradeAfter.userId == resource.data.userId &&
        tradeAfter.symbol == resource.data.symbol && tradeAfter.side == resource.data.side &&
        tradeAfter.quantity == resource.data.quantity &&
        tradeAfter.executionPrice == request.resource.data.filledPrice;
    }

    match /users/{userId} {
      allow read: if ownsDocument(userId) || isAdmin();

      allow create: if ownsDocument(userId) &&
        hasExactFields([
          'uid',
          'fullName',
          'email',
          'role',
          'accountStatus',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.fullName is string &&
        request.resource.data.email is string &&
        request.resource.data.role == 'user' &&
        request.resource.data.accountStatus == 'active' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if (ownsDocument(userId) && isActiveUser() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fullName', 'updatedAt']) &&
          request.resource.data.fullName is string &&
          request.resource.data.fullName.size() > 0 &&
          request.resource.data.updatedAt == request.time) ||
        validAdminRoleUpdate(userId);
    }

    match /wallets/{userId} {
      allow read: if (ownsDocument(userId) && isActiveUser()) || isAdmin();

      allow create: if ownsDocument(userId) && isActiveUser() &&
        hasExactFields([
          'userId',
          'currency',
          'availableBalance',
          'lockedBalance',
          'totalDeposited',
          'totalWithdrawn',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.currency == 'USD' &&
        request.resource.data.availableBalance == 0 &&
        request.resource.data.lockedBalance == 0 &&
        request.resource.data.totalDeposited == 0 &&
        request.resource.data.totalWithdrawn == 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if (isAdmin() && validWalletApprovalUpdate(userId)) ||
        (ownsDocument(userId) && isActiveUser() && validWalletTradeUpdate(userId));
    }

    match /positions/{positionId} {
      allow read: if (isActiveUser() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isActiveUser() && validPositionCreate(positionId);
      allow update: if isActiveUser() && resource.data.userId == request.auth.uid &&
        (validPositionUpdate() || validProtectionUpdate());
    }

    match /orders/{orderId} {
      allow read: if isActiveUser() && resource.data.userId == request.auth.uid;
      allow create: if isActiveUser() && validPendingOrderCreate();
      allow update: if isActiveUser() && resource.data.userId == request.auth.uid &&
        (validOrderCancel() || validOrderEdit() || validOrderFill(orderId));
    }

    match /trades/{tradeId} {
      allow read: if (isActiveUser() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isActiveUser() &&
        validTradeShape(tradeId, request.resource.data);
    }

    match /transactions/{transactionId} {
      allow read: if (isActiveUser() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAdmin() && validCompletedTransaction(transactionId);
    }

    match /notifications/{notificationId} {
      allow read: if isActiveUser() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin() && validFundingNotification();
      allow update: if isActiveUser() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        resource.data.read == false && request.resource.data.read == true;
    }

    match /deposits/{depositId} {
      allow read: if (isActiveUser() && resource.data.userId == request.auth.uid) || isAdmin();

      allow create: if isActiveUser() &&
        request.resource.data.keys().hasAll([
          'userId',
          'amount',
          'currency',
          'method',
          'paymentCategory',
          'accountHolderName',
          'senderAccount',
          'reference',
          'notes',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly(['userId', 'amount', 'currency', 'method', 'paymentCategory', 'accountHolderName', 'senderAccount', 'bankName', 'reference', 'notes', 'status', 'createdAt', 'updatedAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.currency == 'USD' &&
        validPakistaniPaymentMethod(request.resource.data) &&
        request.resource.data.accountHolderName is string && request.resource.data.accountHolderName.size() > 0 && request.resource.data.accountHolderName.size() <= 120 &&
        request.resource.data.senderAccount is string && request.resource.data.senderAccount.size() > 0 && request.resource.data.senderAccount.size() <= 80 &&
        request.resource.data.reference is string &&
        request.resource.data.reference.size() > 0 &&
        request.resource.data.reference.size() <= 120 &&
        request.resource.data.notes is string && request.resource.data.notes.size() <= 500 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if isAdmin() &&
        (validDepositApproval(depositId) || validDepositRejection());
    }

    match /withdrawals/{withdrawalId} {
      allow read: if (isActiveUser() && resource.data.userId == request.auth.uid) || isAdmin();

      allow create: if isActiveUser() &&
        request.resource.data.keys().hasAll([
          'userId',
          'amount',
          'currency',
          'method',
          'paymentCategory',
          'accountHolderName',
          'destinationAccount',
          'notes',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly(['userId', 'amount', 'currency', 'method', 'paymentCategory', 'accountHolderName', 'destinationAccount', 'bankName', 'notes', 'status', 'createdAt', 'updatedAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.currency == 'USD' &&
        validPakistaniPaymentMethod(request.resource.data) &&
        request.resource.data.accountHolderName is string && request.resource.data.accountHolderName.size() > 0 && request.resource.data.accountHolderName.size() <= 120 &&
        request.resource.data.destinationAccount is string &&
        request.resource.data.destinationAccount.size() > 0 && request.resource.data.destinationAccount.size() <= 80 &&
        request.resource.data.notes is string && request.resource.data.notes.size() <= 500 &&
        request.resource.data.amount <=
          get(/databases/$(database)/documents/wallets/$(request.auth.uid))
            .data.availableBalance &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if isAdmin() &&
        (validWithdrawalApproval(withdrawalId) || validWithdrawalRejection());
    }

    match /watchlists/{userId} {
      allow read: if ownsDocument(userId) && isActiveUser();

      allow create: if ownsDocument(userId) && isActiveUser() &&
        hasExactFields(['userId', 'symbols', 'createdAt', 'updatedAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.symbols is list &&
        request.resource.data.symbols.size() == 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if ownsDocument(userId) && isActiveUser() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['symbols', 'updatedAt']) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.symbols is list &&
        request.resource.data.symbols.size() <= 100 &&
        request.resource.data.updatedAt == request.time;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasExactFields(requiredFields) {
      return request.resource.data.keys().hasAll(requiredFields) &&
        request.resource.data.keys().hasOnly(requiredFields);
    }

    match /users/{userId} {
      allow read: if ownsDocument(userId);

      allow create: if ownsDocument(userId) &&
        hasExactFields([
          'uid',
          'fullName',
          'email',
          'role',
          'accountStatus',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.fullName is string &&
        request.resource.data.email is string &&
        request.resource.data.role == 'user' &&
        request.resource.data.accountStatus == 'active' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if ownsDocument(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'updatedAt']) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        request.resource.data.updatedAt == request.time;
    }

    match /wallets/{userId} {
      allow read: if ownsDocument(userId);

      allow create: if ownsDocument(userId) &&
        hasExactFields([
          'userId',
          'currency',
          'availableBalance',
          'lockedBalance',
          'totalDeposited',
          'totalWithdrawn',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.currency == 'USD' &&
        request.resource.data.availableBalance == 0 &&
        request.resource.data.lockedBalance == 0 &&
        request.resource.data.totalDeposited == 0 &&
        request.resource.data.totalWithdrawn == 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    match /positions/{positionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /transactions/{transactionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /deposits/{depositId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn() &&
        hasExactFields([
          'userId',
          'amount',
          'currency',
          'method',
          'reference',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.currency == 'USD' &&
        request.resource.data.method is string &&
        request.resource.data.method.size() > 0 &&
        request.resource.data.method in ['Bank Transfer', 'USDT', 'BTC'] &&
        request.resource.data.reference is string &&
        request.resource.data.reference.size() > 0 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    match /withdrawals/{withdrawalId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn() &&
        hasExactFields([
          'userId',
          'amount',
          'currency',
          'method',
          'destination',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.currency == 'USD' &&
        request.resource.data.method is string &&
        request.resource.data.method.size() > 0 &&
        request.resource.data.method in ['Bank Transfer', 'USDT', 'BTC'] &&
        request.resource.data.destination is string &&
        request.resource.data.destination.size() > 0 &&
        request.resource.data.amount <=
          get(/databases/$(database)/documents/wallets/$(request.auth.uid))
            .data.availableBalance &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    match /watchlists/{userId} {
      allow read: if ownsDocument(userId);

      allow create: if ownsDocument(userId) &&
        hasExactFields(['userId', 'symbols', 'createdAt', 'updatedAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.symbols is list &&
        request.resource.data.symbols.size() == 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if ownsDocument(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['symbols', 'updatedAt']) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.symbols is list &&
        request.resource.data.symbols.size() <= 100 &&
        request.resource.data.updatedAt == request.time;
    }
  }
}

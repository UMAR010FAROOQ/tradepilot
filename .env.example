# Every VITE_ value is embedded in browser assets and must be safe to expose.
# Required: copy these public Firebase web-app settings into .env.local for development
# and configure the same names in the production build environment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: browser-safe URL for a trusted Twelve Data-compatible proxy.
# Keep the provider API key on the proxy; never put it in a VITE_ variable.
# If omitted, Forex and Gold show an unavailable state while Crypto remains usable.
VITE_FOREX_API_BASE_URL=

# Optional public receiving instructions. These are visible to every visitor.
# Never store API keys, PINs, passwords, OTPs, or private account credentials here.
VITE_JAZZCASH_RECEIVING_ACCOUNT=
VITE_EASYPAISA_RECEIVING_ACCOUNT=
VITE_SADAPAY_RECEIVING_ACCOUNT=
VITE_NAYAPAY_RECEIVING_ACCOUNT=
VITE_BANK_RECEIVING_DETAILS=
# Optional public support address.
VITE_SUPPORT_EMAIL=
